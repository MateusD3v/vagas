NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://job_agent:job_agent@localhost:5432/job_agent?schema=public
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_ADJUSTMENT_LIMIT=10
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
ADMIN_API_KEY=
SEED_DEMO_DATA=true
WORKER_MODE=continuous
WORKER_HEALTH_TTL_SECONDS=90
WORKER_CYCLE_LOCK_TTL_MINUTES=30
JOB_COLLECTION_CRON=0 */6 * * *
JOB_SOURCE_TIMEOUT_MS=10000
JOB_SOURCE_MAX_RETRIES=3
JOB_SOURCE_USER_AGENT=JobApplicationAgent/0.3 (+local-development)
SOURCE_FAILURE_THRESHOLD=5
SOURCE_COOLDOWN_MINUTES=30
COLLECTION_RUN_RETENTION_DAYS=30
AUDIT_LOG_RETENTION_DAYS=90
JOB_STALE_AFTER_DAYS=14
JOB_CLOSED_AFTER_DAYS=30
JOB_STATUS_SYNC_INTERVAL_MINUTES=360
JOB_STATUS_SYNC_BATCH_SIZE=100
AUTO_ANALYZE_NEW_JOBS=true
LLM_MAX_ANALYSES_PER_RUN=25
LLM_MAX_ANALYSES_PER_DAY=100
MATCHING_ENGINE_VERSION=3
MAX_JOB_AGE_DAYS=14
ENABLE_REAL_JOB_SOURCES=true
ENABLE_AUTO_ANALYSIS=true
AUTO_PREPARE_APPLICATIONS=true
APPLICATION_PREPARATION_INTERVAL_SECONDS=60
APPLICATION_PREPARATION_BATCH_SIZE=25
ENABLE_NOTIFICATIONS=false
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_TIMEOUT_MS=5000
ENABLE_SCHEDULER=true
SAFE_MODE=true
REMOTIVE_ENABLED=true
ARBEITNOW_ENABLED=true
JOBICY_ENABLED=true
HIMALAYAS_ENABLED=true
REMOTEOK_ENABLED=true
WEWORKREMOTELY_ENABLED=true
SOLIDES_ENABLED=true
GUPY_ENABLED=true
RAW_DATA_MAX_BYTES=50000

# Gmail OAuth for this deployment (not the ChatGPT connector). Empty = not configured.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=
GMAIL_TOKEN_ENCRYPTION_KEY=
GMAIL_SEND_ENABLED=false
AUTO_SUBMIT_APPLICATIONS=false
